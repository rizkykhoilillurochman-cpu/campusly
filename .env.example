NODE_ENV=production
PORT=8787
GEMINI_API_KEY=
# Optional: preferred model; server verifies it dynamically with ListModels.
GEMINI_MODEL=
# Optional image sources for PPT.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Optional; must be a model returned by Gemini ListModels that supports image generation.
GEMINI_IMAGE_MODEL=
# Optional Canva OAuth / Design Import integration.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://your-domain.example/api/canva/callback
# Set true only when the deployment is behind a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY=false
